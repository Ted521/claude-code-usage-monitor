# Claude 로그/설정 디렉터리 (호스트 절대 경로, docker compose 필수)
# Windows: C:\Users\<사용자명>\.claude
# Linux/macOS: /home/<사용자명>/.claude
CLAUDE_DATA_DIR=

WEB_PORT=5000
API_PORT=8000

HISTORY_TTL_SEC=60
REALTIME_TTL_SEC=60

# 선택 — 미설정 시 docker-compose.yml 기본값 사용
# CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
# API_BASE_URL=http://localhost:8000
