# Claude 로그/설정 디렉터리 (호스트 절대 경로, docker compose 필수)
# Windows: C:\Users\<사용자명>\.claude
# Linux/macOS: /home/<사용자명>/.claude
CLAUDE_DATA_DIR=

WEB_PORT=5000
API_PORT=8000

HISTORY_TTL_SEC=60
REALTIME_TTL_SEC=60

# 오늘 시간별 차트 — API가 분 단위로 ccusage daily(오늘) 스냅샷 저장
MINUTE_SNAPSHOT_ENABLED=true
MINUTE_SNAPSHOT_INTERVAL_SEC=60
# 분 스냅샷 호스트 경로 (Compose 바인드 마운트, 재빌드 후에도 유지)
# Windows 예: USAGE_TIMELINE_HOST_DIR=./data/timeline
USAGE_TIMELINE_HOST_DIR=./data/timeline

# 선택 — 미설정 시 docker-compose.yml 기본값 사용
# CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
# API_BASE_URL=http://localhost:8000
